MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/volunteerconnect
JWT_SECRET=your_super_secret_jwt_key_here
PORT=5000
CLIENT_URL=http://localhost:5173
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
ADMIN_EMAIL=admin@volunteerconnect.com
ADMIN_PASSWORD=Admin@123456
MAPS_API_KEY=your_optional_maps_api_key
NEWS_API_KEY=your_optional_news_api_key
GEOCODING_API_KEY=your_optional_geocoding_api_key

# Email & OTP SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_email@gmail.com
SMTP_PASSWORD=your_smtp_app_password
SMTP_FROM_EMAIL=no-reply@volunteerconnect.org
SMTP_FROM_NAME="Virtual Connect"
SMTP_USE_TLS=true

